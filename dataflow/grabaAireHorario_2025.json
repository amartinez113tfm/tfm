{
	"name": "grabaAireHorario_2025",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "datosAire2025",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Parquet1",
						"type": "DatasetReference"
					},
					"name": "parquet"
				}
			],
			"transformations": [
				{
					"name": "unpivot1"
				},
				{
					"name": "derivedColumn1",
					"description": "Crea una nueva columna con la fecha completa"
				},
				{
					"name": "select1"
				},
				{
					"name": "AddUTC",
					"description": "Crea una columna UTC partiendo de la fecha y la hora"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"select1 unpivot(output(",
				"          Hora as integer,",
				"          Medida as double",
				"     ),",
				"     ungroupBy(fechaTotal,",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          PUNTO_MUESTREO,",
				"          MAGNITUD),",
				"     lateral: false,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"source1 derive(fechaTotal = toDate(\r",
				"  concat(\r",
				"    toString(ANO), '-', \r",
				"    toString(MES), '-', \r",
				"    toString(DIA)\r",
				"  ), \r",
				"  'yyyy-MM-dd'\r",
				")) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          MAGNITUD,",
				"          PUNTO_MUESTREO,",
				"          {01} = H01,",
				"          {02} = H02,",
				"          {03} = H03,",
				"          {04} = H04,",
				"          {05} = H05,",
				"          {06} = H06,",
				"          {07} = H07,",
				"          {08} = H08,",
				"          {09} = H09,",
				"          {10} = H10,",
				"          {11} = H11,",
				"          {12} = H12,",
				"          {13} = H13,",
				"          {14} = H14,",
				"          {15} = H15,",
				"          {16} = H16,",
				"          {17} = H17,",
				"          {18} = H18,",
				"          {19} = H19,",
				"          {20} = H20,",
				"          {21} = H21,",
				"          {22} = H22,",
				"          {23} = H23,",
				"          {24} = H24,",
				"          fechaTotal",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"unpivot1 derive(UTCTime = toTimestamp(\r",
				"        iif(\r",
				"            toInteger(Hora) == 24,\r",
				"            concat(\r",
				"                toString(addDays(fechaTotal, 1), 'yyyy-MM-dd'),\r",
				"                ' 00'\r",
				"            ),\r",
				"            concat(\r",
				"                toString(fechaTotal, 'yyyy-MM-dd'), \r",
				"                ' ',\r",
				"                lpad(toString(toInteger(Hora)), 2, '0') \r",
				"            )\r",
				"        ),\r",
				"        'yyyy-MM-dd HH'\r",
				"    )) ~> AddUTC",
				"AddUTC sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> parquet"
			]
		}
	}
}