{
	"name": "grabaMeteoMes",
	"properties": {
		"folder": {
			"name": "meteo"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "CSVMeteoMes",
						"type": "DatasetReference"
					},
					"name": "source1",
					"description": "Importar datos de totalMeteo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ParquetMeteoMes",
						"type": "DatasetReference"
					},
					"name": "parquet"
				}
			],
			"transformations": [
				{
					"name": "unpivot1"
				},
				{
					"name": "derivedColumn1",
					"description": "Crea una nueva columna con la fecha completa"
				},
				{
					"name": "select1"
				},
				{
					"name": "AddUTC",
					"description": "Crea una columna UTC partiendo de la fecha y la hora"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {PROVINCIA;MUNICIPIO;ESTACION;MAGNITUD;PUNTO_MUESTREO;ANO;MES;DIA;H01;V01;H02;V02;H03;V03;H04;V04;H05;V05;H06;V06;H07;V07;H08;V08;H09;V09;H10;V10;H11;V11;H12;V12;H13;V13;H14;V14;H15;V15;H16;V16;H17;V17;H18;V18;H19;V19;H20;V20;H21;V21;H22;V22;H23;V23;H24;V24} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"select1 unpivot(output(",
				"          Hora as integer,",
				"          Medida as double",
				"     ),",
				"     ungroupBy(fechaTotal,",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          PUNTO_MUESTREO,",
				"          MAGNITUD),",
				"     lateral: false,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"source1 derive(fechaTotal = toDate(\r",
				"  concat(\r",
				"    toString(ANO), '-', \r",
				"    toString(MES), '-', \r",
				"    toString(DIA)\r",
				"  ), \r",
				"  'yyyy-MM-dd'\r",
				")) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          MAGNITUD,",
				"          PUNTO_MUESTREO,",
				"          {01} = H01,",
				"          {02} = H02,",
				"          {03} = H03,",
				"          {04} = H04,",
				"          {05} = H05,",
				"          {06} = H06,",
				"          {07} = H07,",
				"          {08} = H08,",
				"          {09} = H09,",
				"          {10} = H10,",
				"          {11} = H11,",
				"          {12} = H12,",
				"          {13} = H13,",
				"          {14} = H14,",
				"          {15} = H15,",
				"          {16} = H16,",
				"          {17} = H17,",
				"          {18} = H18,",
				"          {19} = H19,",
				"          {20} = H20,",
				"          {21} = H21,",
				"          {22} = H22,",
				"          {23} = H23,",
				"          {24} = H24,",
				"          fechaTotal",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"unpivot1 derive(UTCTime = toTimestamp(\r",
				"        iif(\r",
				"            toInteger(Hora) == 24,\r",
				"            concat(\r",
				"                toString(addDays(fechaTotal, 1), 'yyyy-MM-dd'),\r",
				"                ' 00'\r",
				"            ),\r",
				"            concat(\r",
				"                toString(fechaTotal, 'yyyy-MM-dd'), \r",
				"                ' ',\r",
				"                lpad(toString(toInteger(Hora)), 2, '0') \r",
				"            )\r",
				"        ),\r",
				"        'yyyy-MM-dd HH'\r",
				"    )) ~> AddUTC",
				"AddUTC sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          fechaTotal as date,",
				"          PROVINCIA as short,",
				"          MUNICIPIO as short,",
				"          ESTACION as short,",
				"          PUNTO_MUESTREO as string,",
				"          MAGNITUD as short,",
				"          Hora as string,",
				"          Medida as double,",
				"          UTCTime as timestamp",
				"     ),",
				"     format: 'parquet',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> parquet"
			]
		}
	}
}