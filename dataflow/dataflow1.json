{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "salida_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "unpivot1"
				},
				{
					"name": "derivedColumn1",
					"description": "Crea una nueva columna con la fecha completa"
				}
			],
			"scriptLines": [
				"source(output(",
				"          PROVINCIA as short,",
				"          MUNICIPIO as short,",
				"          ESTACION as short,",
				"          MAGNITUD as short,",
				"          PUNTO_MUESTREO as string,",
				"          ANO as short,",
				"          MES as short,",
				"          DIA as short,",
				"          H01 as double,",
				"          V01 as string,",
				"          H02 as double,",
				"          V02 as string,",
				"          H03 as double,",
				"          V03 as string,",
				"          H04 as double,",
				"          V04 as string,",
				"          H05 as double,",
				"          V05 as string,",
				"          H06 as double,",
				"          V06 as string,",
				"          H07 as double,",
				"          V07 as string,",
				"          H08 as double,",
				"          V08 as string,",
				"          H09 as double,",
				"          V09 as string,",
				"          H10 as double,",
				"          V10 as string,",
				"          H11 as double,",
				"          V11 as string,",
				"          H12 as double,",
				"          V12 as string,",
				"          H13 as double,",
				"          V13 as string,",
				"          H14 as double,",
				"          V14 as string,",
				"          H15 as double,",
				"          V15 as string,",
				"          H16 as double,",
				"          V16 as string,",
				"          H17 as double,",
				"          V17 as string,",
				"          H18 as double,",
				"          V18 as string,",
				"          H19 as double,",
				"          V19 as string,",
				"          H20 as double,",
				"          V20 as string,",
				"          H21 as double,",
				"          V21 as string,",
				"          H22 as double,",
				"          V22 as string,",
				"          H23 as double,",
				"          V23 as string,",
				"          H24 as double,",
				"          V24 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"derivedColumn1 unpivot(output(",
				"          Hora as string,",
				"          Medida as double",
				"     ),",
				"     ungroupBy(fechaTotal,",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          PUNTO_MUESTREO,",
				"          MAGNITUD),",
				"     lateral: true,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"source1 derive(fechaTotal = toDate(\r",
				"  concat(\r",
				"    toString(ANO), '-', \r",
				"    toString(MES), '-', \r",
				"    toString(DIA)\r",
				"  ), \r",
				"  'yyyy-MM-dd'\r",
				")) ~> derivedColumn1"
			]
		}
	}
}