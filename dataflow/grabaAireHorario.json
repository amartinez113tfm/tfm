{
	"name": "grabaAireHorario",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "salida_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"description": "Exportar datos a base de datos aire.air.lectura_horaria"
				}
			],
			"transformations": [
				{
					"name": "unpivot1"
				},
				{
					"name": "derivedColumn1",
					"description": "Crea una nueva columna con la fecha completa"
				},
				{
					"name": "select1"
				},
				{
					"name": "AddUTC",
					"description": "Crea una columna UTC partiendo de la fecha y la hora"
				}
			],
			"scriptLines": [
				"source(output(",
				"          PROVINCIA as short,",
				"          MUNICIPIO as short,",
				"          ESTACION as short,",
				"          MAGNITUD as short,",
				"          PUNTO_MUESTREO as string,",
				"          ANO as short,",
				"          MES as short,",
				"          DIA as short,",
				"          H01 as double,",
				"          V01 as string,",
				"          H02 as double,",
				"          V02 as string,",
				"          H03 as double,",
				"          V03 as string,",
				"          H04 as double,",
				"          V04 as string,",
				"          H05 as double,",
				"          V05 as string,",
				"          H06 as double,",
				"          V06 as string,",
				"          H07 as double,",
				"          V07 as string,",
				"          H08 as double,",
				"          V08 as string,",
				"          H09 as double,",
				"          V09 as string,",
				"          H10 as double,",
				"          V10 as string,",
				"          H11 as double,",
				"          V11 as string,",
				"          H12 as double,",
				"          V12 as string,",
				"          H13 as double,",
				"          V13 as string,",
				"          H14 as double,",
				"          V14 as string,",
				"          H15 as double,",
				"          V15 as string,",
				"          H16 as double,",
				"          V16 as string,",
				"          H17 as double,",
				"          V17 as string,",
				"          H18 as double,",
				"          V18 as string,",
				"          H19 as double,",
				"          V19 as string,",
				"          H20 as double,",
				"          V20 as string,",
				"          H21 as double,",
				"          V21 as string,",
				"          H22 as double,",
				"          V22 as string,",
				"          H23 as double,",
				"          V23 as string,",
				"          H24 as double,",
				"          V24 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"select1 unpivot(output(",
				"          Hora as integer,",
				"          Medida as double",
				"     ),",
				"     ungroupBy(fechaTotal,",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          PUNTO_MUESTREO,",
				"          MAGNITUD),",
				"     lateral: false,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"source1 derive(fechaTotal = toDate(\r",
				"  concat(\r",
				"    toString(ANO), '-', \r",
				"    toString(MES), '-', \r",
				"    toString(DIA)\r",
				"  ), \r",
				"  'yyyy-MM-dd'\r",
				")) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          PROVINCIA,",
				"          MUNICIPIO,",
				"          ESTACION,",
				"          MAGNITUD,",
				"          PUNTO_MUESTREO,",
				"          {01} = H01,",
				"          {02} = H02,",
				"          {03} = H03,",
				"          {04} = H04,",
				"          {05} = H05,",
				"          {06} = H06,",
				"          {07} = H07,",
				"          {08} = H08,",
				"          {09} = H09,",
				"          {10} = H10,",
				"          {11} = H11,",
				"          {12} = H12,",
				"          {13} = H13,",
				"          {14} = H14,",
				"          {15} = H15,",
				"          {16} = H16,",
				"          {17} = H17,",
				"          {18} = H18,",
				"          {19} = H19,",
				"          {20} = H20,",
				"          {21} = H21,",
				"          {22} = H22,",
				"          {23} = H23,",
				"          {24} = H24,",
				"          fechaTotal",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"unpivot1 derive(UTCTime = toTimestamp(\r",
				"        iif(\r",
				"            toInteger(Hora) == 24,\r",
				"            concat(\r",
				"                toString(addDays(fechaTotal, 1), 'yyyy-MM-dd'),\r",
				"                ' 00'\r",
				"            ),\r",
				"            concat(\r",
				"                toString(fechaTotal, 'yyyy-MM-dd'), \r",
				"                ' ',\r",
				"                lpad(toString(toInteger(Hora)), 2, '0') \r",
				"            )\r",
				"        ),\r",
				"        'yyyy-MM-dd HH'\r",
				"    )) ~> AddUTC",
				"AddUTC sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}