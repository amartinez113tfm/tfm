{
	"name": "ficherosTrafico",
	"properties": {
		"description": "Ficheros zip de trafico mensual",
		"linkedServiceName": {
			"referenceName": "HttpTrafico",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"URL_relativa": {
				"type": "string"
			}
		},
		"folder": {
			"name": "trafico"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "HttpServerLocation",
				"relativeUrl": {
					"value": "@dataset().URL_relativa",
					"type": "Expression"
				}
			},
			"columnDelimiter": ";",
			"compressionCodec": "ZipDeflate",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}